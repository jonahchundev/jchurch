{
  "expo": {
    "name": "JChurch",
    "slug": "jc-church-mobile",
    "scheme": "jchurch",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow JChurch to scan member codes and take member photos.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow JChurch to add a member photo from your photo library."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jchurch.mobile"
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.jchurch.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
