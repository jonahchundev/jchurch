{
  "expo": {
    "name": "JChurch",
    "slug": "jc-church-mobile",
    "scheme": "jchurch",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      ["expo-camera", { "cameraPermission": "Allow JChurch to scan member QR codes and barcodes.", "recordAudioAndroid": false, "microphonePermission": false }],
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
